module bcd_7seg_decoder(input [3:0] bcd, output reg [6:0] seg);

always @(bcd) begin
    case(bcd)
        4'd0: seg = 7'b1000000;
        4'd1: seg = 7'b1111001;
        4'd2: seg = 7'b0100100;
        4'd3: seg = 7'b0110000;
        4'd4: seg = 7'b0011001;
        4'd5: seg = 7'b0010010;
        4'd6: seg = 7'b0000010;
        4'd7: seg = 7'b1111000;
        4'd8: seg = 7'b0000000;
        4'd9: seg = 7'b0010000;
        default: seg = 7'b1111111;
    endcase
   end
endmodule

module mux_2_1 (input [3:0] A, B, input sel, output [3:0] mux_out);

    assign mux_out = sel?B:A; //sel =1, mux_out=A

endmodule

module FA(input a, b, c_in, output c_out, s);
//combinational
    assign s = a^b^c_in;
    assign c_out = a&b | a&c_in | b&c_in;
endmodule


module RCA(a, b, c_in, s, c_out);
    input [3:0] a, b;
    input c_in;
    output [3:0] s;
    output c_out;

    wire c1, c2, c3;
    
    FA fa0 (.a(a[0]), .b(b[0]), .c_in(c_in), .c_out(c1),    .s(s[0]));
    FA fa1 (.a(a[1]), .b(b[1]), .c_in(c1),   .c_out(c2),    .s(s[1]));
    FA fa2 (.a(a[2]), .b(b[2]), .c_in(c2),   .c_out(c3),    .s(s[2]));
    FA fa3 (.a(a[3]), .b(b[3]), .c_in(c3),   .c_out(c_out), .s(s[3]));

endmodule


//Top module

module Top(input [3:0] A, B, input Cin, S, output [6:0] seg);
    wire [3:0] rca_sum;
    wire rca_cout;
    wire [3:0] bcd_mux_out;

    // RCA calculates sum and carry-out
    RCA uut1 (.a(A), .b(B), .c_in(Cin), .s(rca_sum), .c_out(rca_cout));

    // Mux selects between sum or padded carry-out based on control signal S
    mux_2_1 uut3 (.A(rca_sum), .B({3'b000, rca_cout}), .sel(S), .mux_out(bcd_mux_out));

    // Decoder converts selected 4-bit value to 7-segment output
    bcd_7seg_decoder uut2 (.bcd(bcd_mux_out),  .seg(seg));
    
endmodule

